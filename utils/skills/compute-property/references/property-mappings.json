{
  "area": {
    "direct": ["Area", "NetArea", "GrossArea", "OpeningArea"],
    "computed": [
      {"formula": "OverallWidth * OverallHeight", "requires": ["OverallWidth", "OverallHeight"]},
      {"formula": "Width * Height", "requires": ["Width", "Height"]},
      {"formula": "W * H", "requires": ["W", "H"]}
    ]
  },
  "volume": {
    "direct": ["Volume", "NetVolume", "GrossVolume"],
    "computed": [
      {"formula": "OverallWidth * OverallHeight * OverallDepth", "requires": ["OverallWidth", "OverallHeight", "OverallDepth"]},
      {"formula": "Width * Height * Depth", "requires": ["Width", "Height", "Depth"]}
    ]
  },
  "perimeter": {
    "direct": ["Perimeter"],
    "computed": [
      {"formula": "2 * (OverallWidth + OverallHeight)", "requires": ["OverallWidth", "OverallHeight"]},
      {"formula": "2 * (Width + Height)", "requires": ["Width", "Height"]}
    ]
  },
  "width": {
    "direct": ["OverallWidth", "Width", "W"],
    "computed": []
  },
  "height": {
    "direct": ["OverallHeight", "Height", "H"],
    "computed": []
  },
  "length": {
    "direct": ["OverallLength", "Length", "L"],
    "computed": []
  },
  "depth": {
    "direct": ["OverallDepth", "Depth", "D"],
    "computed": []
  }
}
